# VS Code workspace
*.code-workspace

# Project state and local config
config/settings.yaml
!config/models.yaml
projects/*

# Generated reports
docs/reports

# OpenSpec working files
openspec/

# Local tooling state
.serena
.skillportrc

# Dependency directories
node_modules/

# Python cache files (generated by Python, not committed)
__pycache__/

# Log files
logs/

# Runtime files (generated by the system, not committed)
runtime/

# Temporary and lock files
.tmp
*.lock
